// =============================================================================
//  Насадка-имя на карандаш (slide-on pencil name)
//
//  ВНИМАНИЕ: это ШАБЛОН. Рабочие .scad создаёт Скрипты/generate_names.py,
//  подставляя значения вместо меток вида {{...}}. Правьте шаблон, а не вывод.
//
//  Геометрия воспроизводит модель MakerWorld #2374615 (обмер по ДИМА_7.8.stl):
//    * буквы выдавлены вверх от общего дна Z = 0 — печать без поддержек;
//    * «зигзаг» — это чередование ВЫСОТЫ букв (body_h + up / body_h - down),
//      а не смещение по вертикали;
//    * сквозное отверстие под карандаш идёт вдоль оси X на высоте body_h / 2.
//
//  Буквы сгруппированы по высоте: два плоских контура объединяются в 2D и
//  выдавливаются один раз каждый. Это на порядок быстрее, чем объединять
//  N отдельных объёмных букв (CGAL считает 3D-union очень долго).
// =============================================================================

/* [Текст] */
letters  = ["Я", "Р", "О", "С", "Л", "А", "В"];   // буквы по отдельности
x_pos    = [-33.9648, -25.0254, -16.2086, -5.7646, 2.8454, 12.9114, 23.8314];      // X-позиция каждой буквы, мм (уже с учётом spacing)
groups   = [[10.25, [1, 3, 5]], [11.4, [0, 2, 4, 6]]];    // [[высота, [индексы букв этой высоты]], ...]
y_off    = -5.8167;      // сдвиг по Y: центрирует текст на оси отверстия

// Перемычки под «висящими» частями глифов: точки у Ё, бревис у Й. Это
// отдельные контуры, без перемычки они выдавливаются в самостоятельные
// столбики и на печати остаются лежать на столе.
// Формат: [[индекс буквы, x0, y0, x1, y1], ...] в мм от начала буквы.
bridges  = [];

/* [Геометрия] */
font_name = "Shantell Sans:style=ExtraBold";     // «nome_font», формат fontconfig: Семейство:style=...
text_size = 12.0;     // «dimensione testo»
body_h    = 10.5;   // «altezza nome» — базовая высота
hole_d    = 7.8;   // «diametro foro» — диаметр под карандаш

bore_z      = 5.0; // высота оси канала над столом, мм
bore_relief = 0.35; // подъём конька над каналом, мм (0 — обычный круг)

text_fn = 64;         // гладкость контуров букв
hole_fn = 96;             // гладкость канала под карандаш

module word_2d(idx) {
    for (i = idx) {
        translate([x_pos[i], y_off])
            text(letters[i], font = font_name, size = text_size,
                 halign = "left", valign = "baseline", $fn = text_fn);

        for (b = bridges)
            if (b[0] == i)
                translate([x_pos[i] + b[1], y_off + b[2]])
                    square([b[3] - b[1], b[4] - b[2]]);
    }
}

// Профиль канала в поперечнике: круг под карандаш плюс «конёк» — крыша
// на 45° над ним. Без конька верх канала печатается мостом и провисает
// внутрь отверстия: сопли цепляют карандаш и царапают его. С коньком
// свисания повисают ВЫШЕ окружности Ø hole_d и карандашу не мешают,
// а сами скаты под 45° печатаются без поддержек.
module bore_profile() {
    r = hole_d / 2;
    a = r / sqrt(2);              // точка, где касательная к кругу идёт под 45°
    c = r + bore_relief;          // высота конька над осью
    b = max(0.01, r * sqrt(2) - c);  // полуширина площадки на коньке

    circle(d = hole_d, $fn = hole_fn);
    if (bore_relief > 0)
        polygon([[-a, a], [a, a], [b, c], [-b, c]]);
}

module bore() {
    // rotate([0,90,0]) rotate([0,0,90]) переводит локальные (x,y,z)
    // в глобальные (z,x,y): ось канала ложится вдоль X, а верх профиля
    // смотрит вверх по Z.
    translate([0, 0, bore_z])
        rotate([0, 90, 0])
            rotate([0, 0, 90])
                linear_extrude(height = 4000, center = true)
                    bore_profile();
}

module pencil_name() {
    difference() {
        union() {
            for (g = groups)
                linear_extrude(height = g[0])
                    word_2d(g[1]);
        }

        bore();
    }
}

pencil_name();
