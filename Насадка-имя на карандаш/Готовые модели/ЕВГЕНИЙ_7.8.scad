// =============================================================================
//  Насадка-имя на карандаш (slide-on pencil name)
//
//  ВНИМАНИЕ: это ШАБЛОН. Рабочие .scad создаёт Скрипты/generate_names.py,
//  подставляя значения вместо меток вида {{...}}. Правьте шаблон, а не вывод.
//
//  Геометрия воспроизводит модель MakerWorld #2374615 (обмер по ДИМА_7.8.stl):
//    * буквы выдавлены вверх от общего дна Z = 0 — печать без поддержек;
//    * «зигзаг» — это чередование ВЫСОТЫ букв (body_h + up / body_h - down),
//      а не смещение по вертикали;
//    * сквозное отверстие под карандаш идёт вдоль оси X на высоте body_h / 2.
//
//  Буквы сгруппированы по высоте: два плоских контура объединяются в 2D и
//  выдавливаются один раз каждый. Это на порядок быстрее, чем объединять
//  N отдельных объёмных букв (CGAL считает 3D-union очень долго).
// =============================================================================

/* [Текст] */
letters  = ["Е", "В", "Г", "Е", "Н", "И", "Й"];   // буквы по отдельности
x_pos    = [-34.3335, -24.8555, -15.9935, -7.7335, 1.5188, 11.5288, 21.9169];      // X-позиция каждой буквы, мм (уже с учётом spacing)
groups   = [[9.75, [1, 3, 5]], [10.9, [0, 2, 4, 6]]];    // [[высота, [индексы букв этой высоты]], ...]
y_off    = -8.0333;      // сдвиг по Y: центрирует текст на оси отверстия

// Перемычки под «висящими» частями глифов: точки у Ё, бревис у Й. Это
// отдельные контуры, без перемычки они выдавливаются в самостоятельные
// столбики и на печати остаются лежать на столе.
// Формат: [[индекс буквы, x0, y0, x1, y1], ...] в мм от начала буквы.
bridges  = [[6, 4.4933, 10.95, 8.3733, 12.85]];

/* [Геометрия] */
font_name = "Shantell Sans:style=ExtraBold";     // «nome_font», формат fontconfig: Семейство:style=...
text_size = 12.0;     // «dimensione testo»
body_h    = 10.0;   // «altezza nome» — базовая высота
hole_d    = 7.8;   // «diametro foro» — диаметр под карандаш

text_fn = 64;         // гладкость контуров букв
hole_fn = 96;             // гладкость канала под карандаш

module word_2d(idx) {
    for (i = idx) {
        translate([x_pos[i], y_off])
            text(letters[i], font = font_name, size = text_size,
                 halign = "left", valign = "baseline", $fn = text_fn);

        for (b = bridges)
            if (b[0] == i)
                translate([x_pos[i] + b[1], y_off + b[2]])
                    square([b[3] - b[1], b[4] - b[2]]);
    }
}

module pencil_name() {
    difference() {
        union() {
            for (g = groups)
                linear_extrude(height = g[0])
                    word_2d(g[1]);
        }

        translate([-1000, 0, body_h / 2])
            rotate([0, 90, 0])
                cylinder(h = 2000, d = hole_d, $fn = hole_fn);
    }
}

pencil_name();
